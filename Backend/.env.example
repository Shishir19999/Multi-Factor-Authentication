PORT=8080
MONGODB_URL=mongodb://localhost:27017/mfa
JWT_SECRET=REPLACE_ME

# --- SMTP (Gmail by default; see README "Sending email with Gmail") ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# false = STARTTLS (port 587); true = implicit TLS (use with port 465)
SMTP_SECURE=false
SMTP_USER=REPLACE_ME
# Gmail App Password (16 characters, needs 2-Step Verification). Leave empty until you create one.
SMTP_PASSWORD=
# Optional From address (Gmail only sends as the logged-in account); defaults to SMTP_USER
SMTP_FROM=

# DEV ONLY: when set, every OTP email is sent to this address instead of the user's (subject says who it was for)
OTP_REDIRECT_EMAIL=
# Email of the demo account created by `npm run seed` (default demo@example.com)
DEMO_EMAIL=

# Comma-separated browser origins allowed by CORS (unset = any origin). Add your LAN origin, e.g. http://192.168.1.79:5173
CORS_ORIGIN=
# Bind address (default 0.0.0.0, reachable from the LAN)
HOST=0.0.0.0
