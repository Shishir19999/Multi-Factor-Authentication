PORT=8080
MONGODB_URL=mongodb://localhost:27017/mfa
# Long random string (for example: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=REPLACE_ME

# --- SMTP (Gmail by default; see README "Sending e-mail with Gmail") ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# false = STARTTLS (port 587); true = implicit TLS (use with port 465)
SMTP_SECURE=false
SMTP_USER=REPLACE_ME
# Gmail App Password (16 characters, needs 2-Step Verification). Leave empty until you create one.
SMTP_PASSWORD=
# Optional From address (Gmail only sends as the logged-in account); defaults to SMTP_USER
MAIL_FROM=

# Where administrator / test e-mail goes (the "Send test e-mail" button and `npm run mail:test`). Never hard-coded.
ADMIN_NOTIFY_EMAIL=
# DEV ONLY: when set, every user-facing e-mail is sent to this address instead of the user's (subject says who it was for)
OTP_REDIRECT_EMAIL=

# First administrator: promotes this account at start-up (or creates it when ADMIN_PASSWORD is also set, 8+ chars with a letter and a number)
ADMIN_EMAIL=
ADMIN_PASSWORD=
# First sample account created by `npm run seed` (default member@example.com)
SAMPLE_EMAIL=

# --- Browser access, cookies, passkeys ---
# Public URL of the frontend (used for links in e-mails)
APP_URL=http://localhost:5173
# Comma-separated browser origins allowed by CORS (with cookies). Unset = http://localhost / 127.0.0.1 on any port.
CORS_ORIGIN=
# Session cookie: SameSite lax (default) | strict | none (none needs COOKIE_SECURE=true). Secure is on automatically when NODE_ENV=production.
COOKIE_SAMESITE=lax
COOKIE_SECURE=
# Passkeys (WebAuthn): relying party id (the site's domain, "localhost" in development) and the exact origin(s)
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:5173
WEBAUTHN_RP_NAME=Multi Factor Authentication
# Number of reverse proxies in front of the API (so rate limits and the sign-in log see the real client IP)
TRUST_PROXY=
# Bind address (default 0.0.0.0, reachable from the LAN)
HOST=0.0.0.0
