# Used by docker-compose.yml
FRONTEND_PORT=8081
BACKEND_PORT=8080
VITE_API_URL=http://localhost:8080
CORS_ORIGIN=http://localhost:8081
# Long random string (for example: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=REPLACE_ME
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=REPLACE_ME
# Gmail App Password (see README); leave empty until you create one
SMTP_PASSWORD=
# Optional From address (Gmail only sends as the logged-in account); defaults to SMTP_USER
MAIL_FROM=
# Where administrator / test e-mail goes (never hard-coded)
ADMIN_NOTIFY_EMAIL=
# First administrator: promotes this account at start-up (or creates it when ADMIN_PASSWORD is also set)
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Public frontend URL (links in e-mails) and passkey (WebAuthn) settings
APP_URL=http://localhost:8081
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:8081
COOKIE_SAMESITE=lax
# DEV ONLY: send every user-facing e-mail to this address instead of the user's
OTP_REDIRECT_EMAIL=
